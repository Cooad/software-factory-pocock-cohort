{
  "name": "Discussion Reply",
  "description": "Notification 7: tells the question author someone replied. Cadence writes the row text from the trigger data; this body is only Knock's fallback.",
  "categories": ["discussion-replies"],
  "steps": [
    {
      "ref": "feed",
      "type": "channel",
      "channel_type": "in_app_feed",
      "channel_key": "cadence-feed",
      "template": {
        "action_url": "{{ data.url }}",
        "markdown_body@": "feed/markdown_body.md"
      }
    }
  ],
  "trigger_frequency": "every_trigger",
  "$schema": "https://schemas.knock.app/cli/workflow.json"
}
